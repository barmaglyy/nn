# Public Supabase project settings. These are safe to expose in a Vite frontend
# when the database has the RLS policies from supabase/contact_messages.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: pre-fill the admin email on /admin.
VITE_ADMIN_EMAIL=

# Local fallback only. Do not rely on this mode for a public production site.
VITE_ADMIN_PASSWORD=buildly-admin